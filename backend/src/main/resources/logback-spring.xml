<configuration>
  <!-- Plain text locally, JSON (one event per line on stdout) under the prod profile, so any log collector
       (Loki, Grafana Cloud, Better Stack, Datadog, kubectl logs | jq, ...) can query fields like requestId/userId -->
  <springProfile name="!prod">
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
  </springProfile>
  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>
    <root level="INFO"><appender-ref ref="JSON"/></root>
  </springProfile>
</configuration>
