SPRING_PROFILES_ACTIVE=prod
# The public URL users open (CORS/WebSocket origin check, OAuth redirects)
CORS_ORIGINS=https://chat.example.com
FRONTEND_URL=https://chat.example.com
APP_BASE_URL=https://chat.example.com
# Managed Postgres (Neon, Supabase, Aiven, your cloud's) or a Helm release; most managed ones need sslmode=require
DB_URL=jdbc:postgresql://postgres:5432/vchat?sslmode=prefer
# Managed Redis (Upstash, Redis Cloud, ...) or a Helm release; REDIS_PASSWORD goes in secrets.env
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL=false
# LOCAL keeps uploads on the backend's volume (uploads-pvc). For S3-compatible storage set STORAGE_MODE=S3, the
# STORAGE_* values below and the keys in secrets.env, and MEDIA_BASE_URL to the bucket's public URL.
STORAGE_MODE=LOCAL
MEDIA_BASE_URL=https://chat.example.com/files
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vchat-media
ADMIN_USERNAMES=
