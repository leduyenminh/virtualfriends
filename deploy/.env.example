# Copy to deploy/.env and fill in. Never commit the copy (.gitignore covers it).

# ---- Public address ----
# A domain whose DNS points at this machine (Caddy then serves HTTPS on 80/443 with a free certificate),
# or :80 to serve plain HTTP, e.g. behind Cloudflare Tunnel or another proxy that terminates TLS.
SITE_ADDRESS=chat.example.com
# What users open in the browser. Also the base of the OAuth redirect URIs.
APP_URL=https://chat.example.com
# Plain-HTTP test on your own machine instead: SITE_ADDRESS=:80, APP_URL=http://localhost, COOKIE_SECURE=false
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- Required secrets (generate each with: openssl rand -base64 48) ----
JWT_SECRET=
DB_PASSWORD=

# ---- Claude (AI friends) and optional voices ----
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# ---- Optional sign-in. Redirect URIs: <APP_URL>/login/oauth2/code/google and .../facebook ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Comma-separated accounts promoted to ADMIN
ADMIN_USERNAMES=

# ---- Uploads ----
# Default: LOCAL, kept on the "uploads" volume and served at <APP_URL>/files.
# Or any S3-compatible object store, e.g. Cloudflare R2 (10 GB free) or Backblaze B2. Make the bucket publicly
# readable (or put a custom domain on it), allow GET from any origin in its CORS rules, and set:
# STORAGE_MODE=S3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=vchat-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# MEDIA_BASE_URL=https://media.example.com

# ---- Frontend build (public client ids for cloud sticker import, baked in at build time) ----
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
# VITE_ONEDRIVE_CLIENT_ID=

# ---- Images: build on this machine (--build), or use the ones CI pushes to GitHub Container Registry ----
# IMAGE_PREFIX=ghcr.io/<github-user>/vchat
# IMAGE_TAG=latest
