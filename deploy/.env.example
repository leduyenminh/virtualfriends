# Copy to deploy/.env and fill in. Never commit the copy (.gitignore covers it).

# ---- Public address ----
# A domain whose DNS points at this machine (Caddy then serves HTTPS on 80/443 with a free certificate),
# or :80 to serve plain HTTP, e.g. behind Cloudflare Tunnel or another proxy that terminates TLS.
SITE_ADDRESS=chat.example.com
# What users open in the browser. Also the base of the OAuth redirect URIs.
APP_URL=https://chat.example.com
# Plain-HTTP test on your own machine instead: SITE_ADDRESS=:80, APP_URL=http://localhost, COOKIE_SECURE=false
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- Cloudflare Tunnel (instead of the two lines above; start with --profile tunnel, see deploy/README.md) ----
# Cloudflare terminates HTTPS, so Caddy serves plain HTTP inside, and only on this machine
# SITE_ADDRESS=:80
# APP_URL=https://chat.example.com
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443
# The token from Zero Trust -> Networks -> Tunnels -> your tunnel
# TUNNEL_TOKEN=
# Per-IP rate limits use the visitor's address that Cloudflare passes on
# CLIENT_IP_HEADERS=Cf-Connecting-Ip
#
# Cloudflare's proxy (orange cloud) pointing straight at this machine instead of a tunnel: keep SITE_ADDRESS as your
# domain, set SSL/TLS mode to Full (strict), use the CLIENT_IP_HEADERS line above, and trust Cloudflare's addresses
# (current list: https://www.cloudflare.com/ips/):
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# ---- Required secrets (generate each with: openssl rand -base64 48) ----
JWT_SECRET=
DB_PASSWORD=

# ---- Claude (AI friends) and optional voices ----
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# ---- Optional sign-in. Redirect URIs: <APP_URL>/login/oauth2/code/google and .../facebook ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Comma-separated accounts promoted to ADMIN
ADMIN_USERNAMES=

# ---- Uploads ----
# Default: LOCAL, kept on the "uploads" volume and served at <APP_URL>/files.
# Or any S3-compatible object store, e.g. Cloudflare R2 (10 GB free; setup in deploy/README.md) or Backblaze B2.
# Make the bucket publicly readable (or put a custom domain on it), allow GET from any origin in its CORS rules, and set:
# STORAGE_MODE=S3
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=vchat-media
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# MEDIA_BASE_URL=https://media.example.com

# ---- Frontend build (public client ids for cloud sticker import, baked in at build time) ----
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
# VITE_ONEDRIVE_CLIENT_ID=

# ---- Images: build on this machine (--build), or use the ones CI pushes to GitHub Container Registry ----
# IMAGE_PREFIX=ghcr.io/<github-user>/vchat
# IMAGE_TAG=latest
